---
layout: null
---
<?xml version="1.0"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }}</title>
  <link href="{{ site.url }}" rel="alternate"/>
  <link type="application/atom+xml" rel="self" href="{{ site.url }}/articles.xml"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>tag:nathany.com,2009:/</id>
  <author>
    <name>{{ site.author }}</name>
    <uri>{{ site.url }}</uri>
  </author>

  {% for post in site.posts %}
  <entry>
    <id>tag:nathany.com,{{ post.date | date: "%Y-%m-%d" }}:{{ post.id }}</id>
    <link type="text/html" rel="alternate" href="{{ site.url }}{{ post.url }}"/>
    <title>{{ post.title }}</title>
    <published>{{ post.date | date_to_xmlschema }}</published>
    {% if post.revised %}
      <updated>{{ post.revised | date_to_xmlschema }}</updated>
    {% endif %}
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}

</feed>
